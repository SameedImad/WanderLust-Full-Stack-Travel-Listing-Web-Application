<% layout('./layouts/boilerplate.ejs') -%>
<script>
    let mapToken="<%=process.env.MAP_TOKEN%>";
    let sample = <%- JSON.stringify(sample) %>;
</script>
<div class="row mt-3">
    <div class="col-8 offset-3">
        <h3><%= sample.title%></h3>
    </div>
    <div class="card col-6 offset-3 show-card listing-card">
        <img src="<%= sample.image.url %>" class="card-img-top show-img" alt="listing_image">
        <br>
        <div class="card-body">
            <p class="card-text">
                <b>Owned by:</b><i><%=sample.owner.username%></i>
                <br>
                <%= sample.description%> <br>
                &#8377;<%= sample.price.toLocaleString("en-IN") %><br>
                <%= sample.location %><br> 
                <%= sample.country %>
            </p>
        </div>
    </div>
    <br>   
    <%if(currUser && currUser._id.equals(sample.owner._id)){%>
    <div class="btns ">
        <a href="/listings/<%= sample._id %>/edit" class="btn btn-dark offset-3 edit-btn">Edit</a>
        <form action="/listings/<%= sample._id %>?_method=DELETE" method="POST" >
            <button class="btn btn-dark offset-5">Delete</button>
        </form>
    </div>
    <%}%>
    <div class="col-8 offset-3">
        <hr>
    <%if(currUser){%>
        <h4>Leave a Review</h4>
        <form action="/listings/<%= sample._id %>/reviews" method="post" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            </div>
            <div class="mb-3 mt-2">
                <label for="comment" class="form-label">Comment</label>
                <textarea name="review[comment]" id="comment" rows="4" cols="30" class="form-control" required></textarea>
                <div class="invalid-feedback">
                    Please give some comment
                </div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <hr>
        <%}%>
        <%if(sample.reviews.length>0){%>
        <p><b>All Reviews</b></p>
        <div class="row">
            <% for (review of sample.reviews) { %>
            <div class="card col-5 mb-3 ms-2">
                <div class="card-body">
                    <h5 class="card-title mt-1">@<%=review.author.username%></h5>
                    <p class="starability-result" data-rating="<%= review.rating %>"></p>
                    <p class="card-text"><%= review.comment %></p>
                </div>
            <div class="mb-3 mt-2">
                <% if (currUser && currUser._id.equals(review.author._id)) { %>
                    <form action="/listings/<%= sample._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                        <button class="btn btn-sm btn-dark">Delete</button>
                    </form>
                <% } %>
            </div>
            </div>
            <% } %>
        </div>
    <%}%>
    </div>
    <div class="col-8 offset-3">
        <h3>Where you'll be</h3>
        <div id="map"></div>
    </div>
</div>
<script src="/js/map.js"></script>

