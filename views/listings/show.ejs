<% layout('./layouts/boilerplate.ejs') -%>

<script>
    let mapToken = "<%= process.env.MAP_TOKEN %>";
    let sample = <%- JSON.stringify(sample) %>;
</script>

<style>
    .star-rating-inline {
        display: inline-flex;
        flex-direction: row-reverse;
        font-size: 2rem;
    }
    .star-rating-inline input { display: none; }
    .star-rating-inline label {
        color: #ccc;
        cursor: pointer;
        transition: color 0.2s;
    }
    .star-rating-inline input:checked ~ label { color: gold; }
    .star-rating-inline label:hover,
    .star-rating-inline label:hover ~ label { color: gold; }
</style>

<div class="row mt-3">

    <div class="col-12 col-md-8 offset-md-2">
        <h3 class="px-2"><%= sample.title %></h3>
    </div>

    <div class="col-12 col-md-8 offset-md-2">
        <div class="card show-card listing-card p-3">
            <img src="<%= sample.image.url %>" class="card-img-top show-img mb-3" alt="listing_image">

            <div class="card-body">
                <p class="card-text">
                    <b>Owned by:</b><br>
                    <i><%= sample.owner.username %></i><br>
                    <%= sample.description %><br>
                    &#8377;<%= sample.price.toLocaleString("en-IN") %><br>
                    <%= sample.location %><br>
                    <%= sample.country %>
                </p>
            </div>

            <% if (currUser && currUser._id.equals(sample.owner._id)) { %>
                <div class="btns mb-3">
                    <a href="/listings/<%= sample._id %>/edit" class="btn btn-dark me-2">Edit</a>
                    <form action="/listings/<%= sample._id %>?_method=DELETE" method="POST" class="d-inline">
                        <button class="btn btn-dark">Delete</button>
                    </form>
                </div>
            <% } %>

            <hr>

            <% if (currUser) { %>
                <h4 class="mb-3">Leave a Review</h4>

                <form action="/listings/<%= sample._id %>/reviews" method="post" novalidate class="needs-validation">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rating</label>
                        <div class="star-rating-inline">
                            <input type="radio" id="star1" name="review[rating]" value="1" checked>
                            <label for="star1">&#9733;</label>

                            <input type="radio" id="star2" name="review[rating]" value="2">
                            <label for="star2">&#9733;</label>

                            <input type="radio" id="star3" name="review[rating]" value="3">
                            <label for="star3">&#9733;</label>

                            <input type="radio" id="star4" name="review[rating]" value="4">
                            <label for="star4">&#9733;</label>

                            <input type="radio" id="star5" name="review[rating]" value="5">
                            <label for="star5">&#9733;</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Comment</label>
                        <textarea name="review[comment]" rows="5" class="form-control shadow-sm" required></textarea>
                        <div class="invalid-feedback">Please give some comment</div>
                    </div>

                    <button class="btn btn-outline-dark">Submit</button>
                </form>
            <% } %>

            <hr class="my-4">

            <% if (sample.reviews.length > 0) { %>
                <h5 class="mb-3">All Reviews</h5>

                <div class="row">
                    <% for (let review of sample.reviews) { %>
                        <div class="col-12 col-md-6 mb-3">
                            <div class="card shadow-sm border-0 h-100 p-2">
                                <div class="card-body">
                                    <h6 class="text-muted">@<%= review.author.username %></h6>
                                    <p><%= review.comment %></p>
                                    <p class="text-warning mb-0">
                                        <% for (let i = 0; i < review.rating; i++) { %>
                                            ⭐
                                        <% } %>
                                    </p>
                                </div>

                                <% if (currUser && currUser._id.equals(review.author._id)) { %>
                                    <div class="p-2">
                                        <form action="/listings/<%= sample._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                                            <button class="btn btn-sm btn-dark">Delete</button>
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>

        </div> 
    </div> 

    <div class="col-12 col-md-8 offset-md-2 p-3">
        <h3>Where you'll be</h3>
        <div id="map" style="height: 400px;" class="rounded shadow-sm"></div>
    </div>

</div> 

<script src="/js/map.js"></script>
